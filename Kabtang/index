<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"/>
<meta name="mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<meta name="theme-color" content="#001230"/>
<title>Portal – Bawaslu Kabupaten Tangerang</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; height: 100%; font-family: 'Plus Jakarta Sans', sans-serif; }
  body { overflow-y: auto; -webkit-overflow-scrolling: touch; }
  body.app-active { overflow: hidden; }

  /* ── PORTAL ──────────────────────────────── */
  #portal {
    position: fixed; inset: 0;
    background: linear-gradient(rgba(0,8,30,.68), rgba(0,8,30,.68)), url("data:image/png;base64,") center/cover no-repeat;
    display: flex; flex-direction: column;
    align-items: center; justify-content: flex-start;
    z-index: 100;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transition: opacity .5s ease, visibility .5s ease;
  }
  #portal.hidden { opacity: 0; visibility: hidden; pointer-events: none; }

  #portal::before {
    content: ''; position: fixed; top: -120px; right: -120px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(200,168,75,.15) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  #portal::after {
    content: ''; position: fixed; bottom: -100px; left: -80px;
    width: 350px; height: 350px;
    background: radial-gradient(circle, rgba(0,53,128,.4) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .portal-inner {
    position: relative; z-index: 1;
    display: flex; flex-direction: column;
    align-items: center; text-align: center;
    padding: 24px 16px 40px;
    width: 100%;
    min-height: 100%;
    justify-content: center;
    animation: fadeUp .6s ease forwards;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .portal-logo {
    width: 76px; height: 76px;
    border-radius: 22px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px;
    overflow: hidden;
  }
  .portal-logo img {
    width: 100%; height: 100%; object-fit: contain;
    -webkit-user-drag: none;
    user-select: none;
  }
  .portal-title { font-size: clamp(.95rem, 4vw, 1.3rem); font-weight: 900; color: #fff; line-height: 1.3; margin-bottom: 6px; text-shadow: 0 2px 12px rgba(0,0,0,.8), 0 1px 4px rgba(0,0,0,.9); }
  .portal-sub   { font-size: clamp(.8rem, 3.5vw, 1.1rem); color: rgba(255,255,255,.75); margin-bottom: 32px; letter-spacing: .3px; text-shadow: 0 2px 12px rgba(0,0,0,.9); }
  .portal-label { font-size: .78rem; font-weight: 700; letter-spacing: 2px; color: rgba(255,255,255,.9); text-transform: uppercase; margin-bottom: 18px; text-shadow: 0 1px 6px rgba(0,0,0,.9); }

  /* ── PORTAL CARDS ─ Grid responsif ──────── */
  .portal-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
    width: 100%;
    max-width: 520px;
    justify-content: center;
  }

  .portal-card {
    background: rgba(0,10,40,.72);
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 20px;
    padding: 24px 16px;
    transition: all .25s ease;
    display: flex; flex-direction: column;
    align-items: center; gap: 12px;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 8px 32px rgba(0,0,0,.45);
    /* Touch-friendly: tap target besar */
    min-height: 160px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .portal-card:hover {
    background: rgba(0,20,60,.88);
    border-color: rgba(200,168,75,.7);
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0,0,0,.6);
  }
  .portal-card:active { transform: scale(.97); }

  .portal-card.last-active {
    border-color: rgba(255,255,255,.35);
    background: rgba(255,255,255,.13);
  }
  .card-admin.last-active    { border-color: rgba(220,80,80,.7); }
  .card-publik.last-active   { border-color: rgba(0,180,120,.7); }

  .card-icon { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
  .card-admin    .card-icon { background: rgba(220,80,80,.2); }
  .card-publik   .card-icon { background: rgba(0,180,120,.2); }
  .card-admin    .card-btn  { background: #dc5050; color: #fff; }
  .card-publik   .card-btn  { background: #00b478; color: #fff; }

  .card-title { font-size: .95rem; font-weight: 800; color: #fff; text-shadow: 0 1px 6px rgba(0,0,0,.6); }
  .card-desc  { font-size: .68rem; color: rgba(255,255,255,.8); text-align: center; line-height: 1.5; flex: 1; }

  .card-btn {
    margin-top: auto;
    padding: 9px 20px;
    border-radius: 99px; border: none; cursor: pointer;
    font-family: inherit; font-size: .78rem; font-weight: 700;
    transition: all .2s;
    min-width: 90px;
    /* Touch: tambah ukuran tap area */
    min-height: 38px;
    -webkit-tap-highlight-color: transparent;
  }
  .card-btn:hover { opacity: .85; transform: scale(1.05); }
  .card-btn:active { transform: scale(.97); }

  .portal-footer { margin-top: 36px; font-size: .75rem; color: rgba(255,255,255,.8); letter-spacing: .5px; }

  /* ── SPLASH ──────────────────────────────── */
  #splash {
    position: fixed; inset: 0;
    background: linear-gradient(135deg, #001230 0%, #003580 60%, #001d50 100%);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    z-index: 200;
    transition: opacity .5s ease, visibility .5s ease;
    padding: env(safe-area-inset-top, 0) 0 env(safe-area-inset-bottom, 0);
  }
  #splash.hidden { opacity: 0; visibility: hidden; pointer-events: none; }

  .splash-logo {
    width: 68px; height: 68px; border-radius: 18px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px; overflow: hidden;
    animation: pulse 1.8s ease-in-out infinite;
    box-shadow: 0 8px 32px rgba(200,168,75,.4);
  }
  .splash-logo img { width: 100%; height: 100%; object-fit: contain; }
  @keyframes pulse {
    0%,100% { box-shadow: 0 8px 32px rgba(200,168,75,.4); transform: scale(1); }
    50%      { box-shadow: 0 8px 48px rgba(200,168,75,.7); transform: scale(1.05); }
  }
  .splash-title { font-size: .95rem; font-weight: 800; color: #fff; margin-bottom: 4px; }
  .splash-sub   { font-size: .73rem; color: rgba(255,255,255,.4); margin-bottom: 28px; text-align: center; padding: 0 24px; }
  .progress-wrap { width: 200px; height: 4px; background: rgba(255,255,255,.1); border-radius: 99px; overflow: hidden; }
  .progress-bar  { height: 100%; background: linear-gradient(90deg,#c8a84b,#e8c96a); border-radius: 99px; width: 0%; }
  .splash-info   { font-size: .68rem; color: rgba(255,255,255,.35); margin-top: 10px; }

  /* ── IFRAME ──────────────────────────────── */
  #app-frame {
    position: fixed; inset: 0;
    width: 100%; height: 100%;
    border: none; opacity: 0; z-index: 50;
    transition: opacity .6s ease;
    /* iOS iframe scrolling fix */
    -webkit-overflow-scrolling: touch;
  }
  #app-frame.visible { opacity: 1; }

  /* ── TOMBOL KEMBALI ──────────────────────── */
  #btn-back {
    position: fixed;
    /* Safe area support untuk iPhone notch/home bar */
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    right: 20px;
    z-index: 300;
    background: rgba(0,21,64,.55);
    border: 1px solid rgba(255,255,255,.18);
    color: rgba(255,255,255,.65); border-radius: 99px;
    padding: 10px 18px 10px 14px;
    font-family: inherit; font-size: .8rem; font-weight: 700;
    cursor: pointer; display: none;
    align-items: center; gap: 6px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 4px 18px rgba(0,0,0,.25);
    opacity: .7;
    transition: background .25s, opacity .25s, color .25s, box-shadow .25s;
    /* Touch friendly */
    min-height: 44px;
    -webkit-tap-highlight-color: transparent;
  }
  #btn-back:hover {
    background: rgba(0,53,128,.92);
    color: #fff;
    opacity: 1;
    box-shadow: 0 6px 24px rgba(0,0,0,.4);
  }
  #btn-back.show  { display: flex; }

  /* ── ERROR ───────────────────────────────── */
  #error-state {
    display: none; position: fixed; inset: 0;
    background: #001d50; z-index: 250;
    align-items: center; justify-content: center;
    flex-direction: column; gap: 16px;
    color: #fff; text-align: center; padding: 24px;
  }
  #error-state.show { display: flex; }
  #error-state h2 { font-size: 1.1rem; color: #ff8a8a; }
  #error-state p  { font-size: .82rem; color: rgba(255,255,255,.5); max-width: 360px; line-height: 1.6; }
  #error-state button {
    padding: 12px 28px; background: #c8a84b; color: #001230;
    border: none; border-radius: 10px;
    font-weight: 800; font-size: .9rem; cursor: pointer;
    min-height: 44px;
  }

  /* ── RESPONSIVE: Mobile kecil ≤ 360px ───── */
  @media (max-width: 360px) {
    .portal-cards { grid-template-columns: 1fr 1fr; gap: 10px; }
    .portal-card { padding: 18px 10px; min-height: 145px; gap: 8px; border-radius: 16px; }
    .card-icon { width: 44px; height: 44px; font-size: 1.2rem; }
    .card-title { font-size: .85rem; }
    .card-desc  { font-size: .62rem; }
    .card-btn   { font-size: .72rem; padding: 7px 14px; }
    .portal-logo { width: 62px; height: 62px; }
    .portal-title { margin-bottom: 4px; }
    .portal-sub { margin-bottom: 24px; }
  }

  /* ── RESPONSIVE: Tablet landscape ≥ 768px ─ */
  @media (min-width: 768px) {
    .portal-cards { grid-template-columns: repeat(2, 1fr); max-width: 440px; }
    .portal-card { padding: 28px 20px; }
    .portal-logo { width: 88px; height: 88px; margin-bottom: 22px; }
  }

  /* ── iOS safe area padding untuk portal ─── */
  @supports (padding: max(0px)) {
    #portal { padding-top: env(safe-area-inset-top, 0px); }
    .portal-inner { padding-bottom: calc(40px + env(safe-area-inset-bottom, 0px)); }
  }
</style>
</head>
<body>

<!-- PORTAL -->
<div id="portal">
  <div class="portal-inner">
    <div class="portal-logo"><img src="data:image/png;base64," alt="Logo Bawaslu"/></div>
    <div class="portal-title">BAWASLU KABUPATEN TANGERANG</div>
    <div class="portal-sub">SISTEM INFORMASI PENGELOLAAN DATA</div>
    <div class="portal-label">Pilih Portal</div>

    <div class="portal-cards">
      <div class="portal-card card-admin" onclick="bukaApp('admin')" role="button" tabindex="0" aria-label="Buka Admin B-DATA">
        <div class="card-icon">🔐</div>
        <div class="card-title">Admin B-DATA</div>
        <div class="card-desc">Sistem Informasi Penanganan Pelanggaran</div>
        <button class="card-btn" onclick="event.stopPropagation(); bukaApp('admin')">Masuk →</button>
      </div>

      <div class="portal-card card-publik" onclick="bukaApp('publik')" role="button" tabindex="0" aria-label="Buka Portal Publik">
        <div class="card-icon">🌐</div>
        <div class="card-title">Publik B-DATA</div>
        <div class="card-desc">Informasi status laporan pelanggaran untuk masyarakat umum</div>
        <button class="card-btn" onclick="event.stopPropagation(); bukaApp('publik')">Buka →</button>
      </div>

    </div>

    <div class="portal-footer">© 2026 - Alfan Fani Septian S</div>
  </div>
</div>

<!-- SPLASH -->
<div id="splash" class="hidden">
  <div class="splash-logo"><img src="data:image/png;base64," alt="Logo Bawaslu"/></div>
  <div class="splash-title">Memuat Aplikasi…</div>
  <div class="splash-sub" id="splash-label">Mohon tunggu sebentar</div>
  <div class="progress-wrap"><div class="progress-bar" id="progress-bar"></div></div>
  <div class="splash-info">Menghubungkan ke server…</div>
</div>

<!-- ERROR -->
<div id="error-state">
  <div style="font-size:3rem">⚠️</div>
  <h2>Gagal Memuat Aplikasi</h2>
  <p>Koneksi ke server gagal. Silakan coba muat ulang.</p>
  <button onclick="kembali()">🔄 Coba Lagi</button>
</div>

<!-- IFRAME -->
<iframe id="app-frame"
  allowfullscreen
  allow="camera; microphone; clipboard-write; speech-recognition"
  title="Bawaslu Kabupaten Tangerang"
></iframe>

<!-- TOMBOL KEMBALI -->
<button id="btn-back" onclick="konfirmasiKembali()">← Portal</button>

<!-- MODAL KONFIRMASI KEMBALI -->
<div id="modal-konfirmasi" style="
  display:none; position:fixed; inset:0; z-index:9999;
  background:rgba(0,0,0,.55); backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px);
  align-items:center; justify-content:center;
  padding: 16px;
">
  <div style="
    background:#fff; border-radius:18px; padding:28px 24px 20px;
    max-width:340px; width:100%; text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,.35);
    animation: modalPop .2s ease;
  ">
    <div style="font-size:2rem; margin-bottom:12px;">⚠️</div>
    <div style="font-size:1rem; font-weight:800; color:#001230; margin-bottom:8px;">Kembali ke Portal?</div>
    <div style="font-size:.82rem; color:#555; line-height:1.6; margin-bottom:24px;">
      Data yang belum tersimpan akan hilang.<br>Pastikan Anda sudah menyimpan pekerjaan sebelum keluar.
    </div>
    <div style="display:flex; gap:10px; justify-content:center;">
      <button onclick="tutupModal()" style="
        flex:1; padding:12px; border-radius:10px; border:1.5px solid #ddd;
        background:#f5f5f5; font-family:inherit; font-size:.85rem;
        font-weight:700; cursor:pointer; color:#444; min-height:44px;
        -webkit-tap-highlight-color:transparent;
      ">Batal</button>
      <button onclick="kembali()" style="
        flex:1; padding:12px; border-radius:10px; border:none;
        background:#002060; font-family:inherit; font-size:.85rem;
        font-weight:700; cursor:pointer; color:#fff; min-height:44px;
        -webkit-tap-highlight-color:transparent;
      ">Ya, Kembali</button>
    </div>
  </div>
</div>

<!-- MODAL PILIH JENIS PENANGANAN (Pemilu / Pemilihan) -->
<div id="modal-jenis" style="
  display:none; position:fixed; inset:0; z-index:9999;
  background:rgba(0,0,0,.55); backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px);
  align-items:center; justify-content:center;
  padding: 16px;
">
  <div style="
    background:#fff; border-radius:18px; padding:28px 24px 20px;
    max-width:360px; width:100%; text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,.35);
    animation: modalPop .2s ease;
  ">
    <div id="modal-jenis-title" style="font-size:1rem; font-weight:800; color:#001230; margin-bottom:6px;">Pilih Jenis Penanganan</div>
    <div style="font-size:.8rem; color:#666; line-height:1.6; margin-bottom:18px;">
      Pilih jenis penanganan yang ingin Anda akses.
    </div>
    <div style="display:flex; gap:10px; justify-content:center; margin-bottom:12px;">
      <div id="mj-opsi-PEMILU" onclick="pilihJenisModal('PEMILU')" style="
        flex:1; border:1.5px solid #d1dae8; border-radius:12px; padding:14px 10px;
        text-align:center; cursor:pointer; font-size:.85rem; font-weight:700;
        color:#555; transition:.15s; -webkit-tap-highlight-color:transparent;
      ">
        Pemilu
        <span style="display:block; font-size:.68rem; font-weight:500; margin-top:3px; opacity:.75;">Presiden/Legislatif</span>
      </div>
      <div id="mj-opsi-PEMILIHAN" onclick="pilihJenisModal('PEMILIHAN')" style="
        flex:1; border:1.5px solid #d1dae8; border-radius:12px; padding:14px 10px;
        text-align:center; cursor:pointer; font-size:.85rem; font-weight:700;
        color:#555; transition:.15s; -webkit-tap-highlight-color:transparent;
      ">
        Pemilihan
        <span style="display:block; font-size:.68rem; font-weight:500; margin-top:3px; opacity:.75;">Gubernur/Bupati/Wali Kota</span>
      </div>
    </div>
    <button onclick="tutupModalJenis()" style="
      width:100%; padding:12px; border-radius:10px; border:1.5px solid #ddd;
      background:#f5f5f5; font-family:inherit; font-size:.85rem;
      font-weight:700; cursor:pointer; color:#444; min-height:44px;
      -webkit-tap-highlight-color:transparent;
    ">Batal</button>
  </div>
</div>

<style>
@keyframes modalPop {
  from { opacity:0; transform:scale(.92) translateY(10px); }
  to   { opacity:1; transform:scale(1) translateY(0); }
}
#mj-opsi-PEMILU:hover, #mj-opsi-PEMILIHAN:hover { border-color:#6C5CE7; background:#EFECFF; color:#4E44B8; }
</style>

<script>
  // Jenis Pemilu (Presiden/Legislatif) - link lama, tidak berubah
  var URL_ADMIN_PEMILU  = atob('aHR0cHM6Ly9zY3JpcHQuZ29vZ2xlLmNvbS9tYWNyb3Mvcy9BS2Z5Y2J4Q2JDZ0s4c2U2cHlvWTVlZ0xOQXY5YS1OY3BVRlBxTUJvLUYxM0FOZUJHbHloTTNnNEI2UFJHZXhKS3NLODY5NnVaQS9leGVjP3BhZ2U9YWRtaW4=');
  var URL_PUBLIK_PEMILU = atob('aHR0cHM6Ly9zY3JpcHQuZ29vZ2xlLmNvbS9tYWNyb3Mvcy9BS2Z5Y2J4Q2JDZ0s4c2U2cHlvWTVlZ0xOQXY5YS1OY3BVRlBxTUJvLUYxM0FOZUJHbHloTTNnNEI2UFJHZXhKS3NLODY5NnVaQS9leGVj');

  // Jenis Pemilihan (Gubernur/Bupati/Wali Kota) - link baru
  var URL_ADMIN_PEMILIHAN  = atob('aHR0cHM6Ly9zY3JpcHQuZ29vZ2xlLmNvbS9tYWNyb3Mvcy9BS2Z5Y2J3S0dEV1RqcXRNU2JtcEt1QnhqX2NvTGNhZC1zSGNEb1Z0UkVlbjRTS2JORnQ5WEowZHB2Y0xSYVhrRDRweGJJZE5uUS9leGVjP3BhZ2U9YWRtaW4=');
  var URL_PUBLIK_PEMILIHAN = atob('aHR0cHM6Ly9zY3JpcHQuZ29vZ2xlLmNvbS9tYWNyb3Mvcy9BS2Z5Y2J3S0dEV1RqcXRNU2JtcEt1QnhqX2NvTGNhZC1zSGNEb1Z0UkVlbjRTS2JORnQ5WEowZHB2Y0xSYVhrRDRweGJJZE5uUS9leGVj');

  // Konfigurasi kartu yang punya 2 varian URL (Pemilu / Pemilihan),
  // dipilih lewat modal-jenis.
  var JENIS_URL_CONFIG = {
    admin: {
      PEMILU:    { url: URL_ADMIN_PEMILU,    label: 'Membuka Admin B-DATA (Pemilu)…' },
      PEMILIHAN: { url: URL_ADMIN_PEMILIHAN, label: 'Membuka Admin B-DATA (Pemilihan)…' }
    },
    publik: {
      PEMILU:    { url: URL_PUBLIK_PEMILU,    label: 'Membuka Portal Publik (Pemilu)…' },
      PEMILIHAN: { url: URL_PUBLIK_PEMILIHAN, label: 'Membuka Portal Publik (Pemilihan)…' }
    }
  };

  // Menyimpan kartu yang sedang menunggu pilihan Pemilu/Pemilihan dari modal-jenis.
  var JENIS_PENDING = null;

  var frame   = document.getElementById('app-frame');
  var splash  = document.getElementById('splash');
  var portal  = document.getElementById('portal');
  var btnBack = document.getElementById('btn-back');
  var errDiv  = document.getElementById('error-state');
  var progBar = document.getElementById('progress-bar');
  var timeout;

  // Keyboard accessibility untuk kartu
  document.querySelectorAll('.portal-card').forEach(function(card) {
    card.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        card.click();
      }
    });
  });

  function bukaApp(jenis) {
    // Kartu Admin/Publik B-DATA punya 2 varian URL (Pemilu / Pemilihan)
    // -> tampilkan modal pilihan dulu.
    if (JENIS_URL_CONFIG[jenis]) {
      JENIS_PENDING = jenis;
      document.getElementById('modal-jenis').style.display = 'flex';
      return;
    }
  }

  // Dipanggil dari tombol Pemilu / Pemilihan di modal-jenis.
  function pilihJenisModal(sub) {
    if (!JENIS_PENDING) return;
    var cfg = JENIS_URL_CONFIG[JENIS_PENDING][sub];
    var jenis = JENIS_PENDING;
    tutupModalJenis();
    mulaiBukaApp(jenis, cfg.url, cfg.label);
  }

  function tutupModalJenis() {
    document.getElementById('modal-jenis').style.display = 'none';
    JENIS_PENDING = null;
  }

  function mulaiBukaApp(jenis, url, label) {
    document.querySelectorAll('.portal-card').forEach(function(c) { c.classList.remove('last-active'); });
    var activeCard = document.querySelector('.card-' + jenis);
    if (activeCard) activeCard.classList.add('last-active');

    splash.classList.remove('hidden');
    document.getElementById('splash-label').textContent = label;

    progBar.style.transition = 'none';
    progBar.style.width = '0%';
    setTimeout(function() {
      progBar.style.transition = 'width 2.5s ease';
      progBar.style.width = '85%';
    }, 50);

    frame.src = 'about:blank';

    frame.onload = function() {
      if (frame.src === 'about:blank' || frame.src === window.location.href) return;
      clearTimeout(timeout);
      progBar.style.transition = 'width .3s ease';
      progBar.style.width = '100%';
      setTimeout(function() {
        splash.classList.add('hidden');
        portal.classList.add('hidden');
        frame.classList.add('visible');
        btnBack.classList.add('show');
        document.body.classList.add('app-active');
      }, 400);
    };

    clearTimeout(timeout);
    timeout = setTimeout(function() {
      splash.classList.add('hidden');
      portal.classList.add('hidden');
      frame.classList.add('visible');
      btnBack.classList.add('show');
      document.body.classList.add('app-active');
    }, 8000);

    setTimeout(function() { frame.src = url; }, 80);
  }

  function konfirmasiKembali() {
    document.getElementById('modal-konfirmasi').style.display = 'flex';
  }

  function tutupModal() {
    document.getElementById('modal-konfirmasi').style.display = 'none';
  }

  function kembali() {
    tutupModal();
    frame.src = 'about:blank';
    frame.classList.remove('visible');
    btnBack.classList.remove('show');
    errDiv.classList.remove('show');
    splash.classList.add('hidden');
    progBar.style.transition = 'none';
    progBar.style.width = '0%';
    portal.classList.remove('hidden');
    document.body.classList.remove('app-active');
  }
</script>

<!-- ═══════════════════════════════════════════════════════════════════
     STT MODAL — dijalankan di portal (top-level origin) agar izin
     mikrofon diberikan ke bw-alfan.github.io, bukan ke iframe.
     Iframe mengirim perintah via postMessage, portal menjalankan STT
     lalu mengirim hasilnya balik ke iframe.
     ═══════════════════════════════════════════════════════════════════ -->
<style>
#_sttPortalOverlay{
  position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:999999;
  display:none;align-items:center;justify-content:center;padding:16px;
}
#_sttPortalOverlay.visible{display:flex;}
#_sttPortalCard{
  background:#fff;border-radius:18px;padding:28px 22px 22px;width:100%;max-width:400px;
  box-shadow:0 8px 40px rgba(0,53,128,.22);text-align:center;
  animation:_sttFadeIn .2s ease;
}
@keyframes _sttFadeIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
#_sttPortalCard h3{font-size:1rem;font-weight:800;color:#003580;margin:0 0 4px;}
#_sttPortalCard .stt-sub{font-size:.78rem;color:#5a6a85;margin-bottom:18px;}
#_sttPortalMicBtn{
  width:72px;height:72px;border-radius:50%;border:none;cursor:pointer;font-size:1.9rem;
  background:#003580;color:#fff;transition:background .2s,transform .1s;
  box-shadow:0 4px 16px rgba(0,53,128,.35);margin-bottom:14px;
}
#_sttPortalMicBtn:hover{background:#002460;}
#_sttPortalMicBtn.stt-on{background:#cc2222;animation:_sttPortalPulse 1s ease-in-out infinite;box-shadow:0 4px 20px rgba(204,34,34,.45);}
@keyframes _sttPortalPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.09)}}
#_sttPortalStatus{font-size:.82rem;font-weight:700;color:#5a6a85;min-height:20px;margin-bottom:12px;}
#_sttPortalStatus.on{color:#cc2222;}
#_sttPortalPreview{
  width:100%;min-height:72px;padding:9px 11px;border:1.5px solid #d1dbe8;
  border-radius:9px;font-family:inherit;font-size:.86rem;color:#1a2540;
  background:#fafcff;resize:vertical;text-align:left;line-height:1.5;box-sizing:border-box;
}
#_sttPortalPreview:focus{outline:none;border-color:#003580;}
#_sttPortalNoSupport{
  background:#fee2e2;border-radius:8px;padding:11px;font-size:.8rem;
  color:#b91c1c;margin-bottom:12px;display:none;
}
._sttPortalActions{display:flex;gap:10px;margin-top:12px;}
._sttPortalBtn{
  flex:1;padding:9px;border-radius:9px;border:none;cursor:pointer;
  font-family:inherit;font-weight:700;font-size:.84rem;transition:background .2s;
}
._sttPortalBtnPrimary{background:#003580;color:#fff;}
._sttPortalBtnPrimary:hover{background:#002460;}
._sttPortalBtnPrimary:disabled{background:#a0b0c8;cursor:default;}
._sttPortalBtnSecondary{background:#f0f4f9;color:#003580;border:1.5px solid #d1dbe8!important;}
._sttPortalBtnSecondary:hover{background:#e2e8f2;}
</style>

<div id="_sttPortalOverlay">
  <div id="_sttPortalCard">
    <h3>🎙️ Dikte Suara</h3>
    <p class="stt-sub">Klik mikrofon, lalu bicara. Teks akan masuk ke form.</p>
    <div id="_sttPortalNoSupport">
      Browser ini tidak mendukung Speech Recognition.<br>
      Gunakan <b>Chrome</b> atau <b>Edge</b> terbaru.
    </div>
    <button id="_sttPortalMicBtn" title="Mulai/Stop Dikte">🎙️</button><br>
    <div id="_sttPortalStatus">Siap</div>
    <textarea id="_sttPortalPreview" spellcheck="false" placeholder="Teks hasil dikte muncul di sini..."></textarea>
    <div class="_sttPortalActions">
      <button class="_sttPortalBtn _sttPortalBtnSecondary" id="_sttPortalClearBtn">Hapus</button>
      <button class="_sttPortalBtn _sttPortalBtnPrimary" id="_sttPortalSendBtn" disabled>Kirim ke Form</button>
    </div>
  </div>
</div>

<script>
(function(){
  var _rec        = null;
  var _committed  = '';
  var _listening  = false;
  var _sourceOrigin = null; // origin iframe yang minta STT

  var overlay   = document.getElementById('_sttPortalOverlay');
  var micBtn    = document.getElementById('_sttPortalMicBtn');
  var statusEl  = document.getElementById('_sttPortalStatus');
  var preview   = document.getElementById('_sttPortalPreview');
  var sendBtn   = document.getElementById('_sttPortalSendBtn');
  var clearBtn  = document.getElementById('_sttPortalClearBtn');
  var noSupport = document.getElementById('_sttPortalNoSupport');

  var SpeechAPI = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SpeechAPI){
    noSupport.style.display = 'block';
    micBtn.disabled = true;
  }

  // ── Buka modal ────────────────────────────────────────────────────────────
  function openModal(origin){
    _sourceOrigin = origin;
    _committed = '';
    _listening = false;
    preview.value = '';
    setStatus('Siap', false);
    sendBtn.disabled = true;
    micBtn.textContent = '🎙️';
    micBtn.classList.remove('stt-on');
    overlay.classList.add('visible');
  }

  // ── Tutup modal ───────────────────────────────────────────────────────────
  function closeModal(sendNotify){
    stopRec();
    overlay.classList.remove('visible');
    _committed = '';
    // Kalau bukan setelah kirim hasil (sendNotify=false), beritahu iframe
    // supaya tombol Dikte di-reset
    if(sendNotify !== false){
      var fr = document.getElementById('app-frame');
      if(fr && fr.contentWindow){
        // Broadcast ke semua nested frame (GAS pakai googleusercontent.com)
        function broadcastCancel(win) {
          try { win.postMessage({ type: 'STT_CANCELLED' }, '*'); } catch(e){}
          for(var i=0; i<win.frames.length; i++){
            try { broadcastCancel(win.frames[i]); } catch(e){}
          }
        }
        try{ broadcastCancel(fr.contentWindow); }catch(e){}
      }
    }
    _sourceOrigin = null;
  }

  // Klik di luar card → tutup
  overlay.addEventListener('click', function(e){
    if(e.target === overlay) closeModal();
  });

  // ── Mic button ────────────────────────────────────────────────────────────
  micBtn.addEventListener('click', function(){
    _listening ? stopRec() : startRec();
  });

  // ── Hapus ─────────────────────────────────────────────────────────────────
  clearBtn.addEventListener('click', function(){
    _committed = '';
    preview.value = '';
    setStatus('Siap', false);
    sendBtn.disabled = true;
    if(_listening) stopRec();
  });

  // ── Kirim ke Form — kirim postMessage balik ke iframe ────────────────────
  sendBtn.addEventListener('click', function(){
    var text = preview.value.trim();
    if(!text) return;
    // Kirim ke semua frame yang mungkin (kita hanya punya satu iframe aktif)
    var fr = document.getElementById('app-frame');
    if(fr && fr.contentWindow){
      console.log('[Portal] Mengirim STT_RESULT ke iframe:', text);
      // GAS berjalan di googleusercontent.com dalam nested frame.
      // Broadcast ke semua frame yang ada di dalam iframe portal.
      function broadcastToFrames(win) {
        try { win.postMessage({ type:'STT_RESULT', text: text }, '*'); } catch(e){}
        for(var i=0; i<win.frames.length; i++){
          try { broadcastToFrames(win.frames[i]); } catch(e){}
        }
      }
      broadcastToFrames(fr.contentWindow);
    }
    setStatus('✓ Terkirim ke form!', false);
    setTimeout(function(){ closeModal(false); }, 700);
  });

  // Update send button saat user edit manual
  preview.addEventListener('input', updateSend);

  // ── Speech Recognition ───────────────────────────────────────────────────
  // Strategi: continuous=false + restart manual di onend.
  //
  // Kenapa bukan continuous=true:
  // Chrome Android sangat buggy dengan continuous=true — result list
  // accumulate lintas sesi restart, interim tidak pernah jadi final,
  // dan duplikasi tidak bisa dicegah dengan index tracking.
  //
  // Dengan continuous=false:
  //   - Satu utterance → satu onresult isFinal=true → onend
  //   - Tidak ada result carry-over antar instance
  //   - _committed hanya diupdate dari teks yang benar-benar final
  //   - Jika _listening masih true saat onend, start instance baru

  function _buildRec(){
    var r = new SpeechAPI();
    r.lang = 'id-ID';
    r.continuous = false;       // satu utterance per sesi — Android-safe
    r.interimResults = false;   // tidak perlu interim, hindari noise
    r.maxAlternatives = 1;

    r.onstart = function(){
      console.log('[STT] onstart');
      micBtn.textContent = '⏹️';
      micBtn.classList.add('stt-on');
      setStatus('● Mendengarkan...', true);
    };

    r.onresult = function(ev){
      // continuous=false: selalu satu result, pasti isFinal
      var text = '';
      for(var i=0; i<ev.results.length; i++){
        if(ev.results[i].isFinal){
          text += ev.results[i][0].transcript;
        }
      }
      text = text.trim();
      console.log('[STT] onresult final:', JSON.stringify(text));
      if(text){
        _committed += (_committed ? ' ' : '') + text;
        preview.value = _committed;
        preview.scrollTop = preview.scrollHeight;
        updateSend();
      }
    };

    r.onerror = function(ev){
      console.log('[STT] onerror:', ev.error);
      if(ev.error==='not-allowed'||ev.error==='permission-denied'){
        _listening = false;
        setStatus('✖ Izin mikrofon ditolak', false);
        alert('Izin mikrofon ditolak. Klik ikon kunci 🔒 di address bar → Izin → Mikrofon → Izinkan, lalu coba lagi.');
        stopState();
      } else if(ev.error==='no-speech'||ev.error==='aborted'){
        // onend akan handle restart
      } else if(ev.error==='network'){
        _listening = false;
        setStatus('✖ Gagal: periksa koneksi', false);
        stopState();
      }
    };

    r.onend = function(){
      console.log('[STT] onend. _listening:', _listening);
      _rec = null;
      if(_listening){
        // Jeda 200ms agar mic release sempurna di Android sebelum restart
        setTimeout(function(){
          if(!_listening) return;
          console.log('[STT] restart untuk utterance berikutnya...');
          _rec = _buildRec();
          try{ _rec.start(); }catch(e){ _listening=false; stopState(); }
        }, 200);
      } else {
        stopState();
      }
    };

    return r;
  }

  function startRec(){
    if(!SpeechAPI){ setStatus('Tidak didukung', false); return; }
    console.log('[STT] startRec dipanggil');
    _committed = '';
    preview.value = '';
    sendBtn.disabled = true;
    _listening = true;
    _rec = _buildRec();
    try{ _rec.start(); }catch(e){ setStatus('Gagal: '+e.message,false); _listening=false; stopState(); }
  }

  function stopRec(){
    _listening = false;  // set false SEBELUM stop agar onend tidak restart
    if(_rec){ try{ _rec.stop(); }catch(e){} }
  }

  function stopState(){
    _listening = false;
    _rec = null;
    micBtn.textContent = '🎙️';
    micBtn.classList.remove('stt-on');
    if(statusEl.classList.contains('on')){
      setStatus(_committed.trim() ? 'Selesai — siap kirim' : 'Siap', false);
    }
    updateSend();
  }

  function setStatus(msg, on){
    statusEl.textContent = msg;
    statusEl.className = on ? 'on' : '';
  }

  function updateSend(){
    sendBtn.disabled = (preview.value.trim().length === 0);
  }

  // ── Listener: terima perintah dari iframe ─────────────────────────────────
  // Filter hanya pesan bertipe STT_* dari kode kita.
  // Tidak pakai ev.source === fr.contentWindow karena GAS load lewat
  // multiple redirect/frame sehingga source tidak selalu cocok.
  window.addEventListener('message', function(ev){
    if(!ev.data || typeof ev.data.type !== 'string') return;
    if(ev.data.type.indexOf('STT_') !== 0) return;
    console.log('[Portal] postMessage diterima:', ev.data.type, 'dari:', ev.origin);

    if(ev.data.type === 'STT_REQUEST'){
      console.log('[Portal] Membuka STT modal...');
      openModal(ev.origin);
    }
    if(ev.data.type === 'STT_CLOSE'){
      closeModal();
    }
  });
})();
</script>
</body>
</html>
